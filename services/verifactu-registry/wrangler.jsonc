{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aula-verifactu-registry",
  "main": "worker.ts",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "send_metrics": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://simulacion.sandramangas.com,https://sandeeacocina-lab.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aula-verifactu-registry",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "local": {
      "vars": {
        "ALLOWED_ORIGINS": "http://127.0.0.1:5173,http://localhost:5173"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aula-verifactu-registry",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
